{
  "name": "carobarreirov.github.io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Carolina Barreiro Valdez's static portfolio and professional profile.",
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5501 --strictPort",
    "build": "vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:html",
    "lint:js": "eslint .",
    "lint:html": "html-validate index.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.8.0",
    "html-validate": "^11.6.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "nanoid": "3.3.17"
  }
}
